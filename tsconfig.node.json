{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "aws-lambda", "vitest/globals"]
  },
  "include": ["amplify/**/*.ts", "shared/**/*.ts", "tests/backend/**/*.ts", "vite.config.ts", "eslint.config.js"]
}
